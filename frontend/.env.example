# Local development only. Set your own PostgreSQL credentials.
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/baby_care?schema=public"
# Generate with: openssl rand -hex 32
AUTH_SECRET=""
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PYTHON_BIN="../ml/.venv/bin/python"
MODEL_LABELS="background,belly_pain,discomfort,hungry,tired"
PREDICTION_CONFIDENCE_THRESHOLD="0.60"
PREDICTION_UNCERTAIN_FLOOR="0.32"
PREDICTION_AMBIGUITY_MARGIN="0.08"
AUDIO_MODEL_FALLBACK_MODE="error"
AUDIO_MODEL_EXPOSE_ERRORS=""
# Optional integrations. Keep real keys out of Git.
DEEPSEEK_API_KEY=""
RESEND_API_KEY=""
NOTIFICATION_EMAIL_FROM=""
PARENT_NOTIFICATION_EMAIL=""
