generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String              @id @default(cuid())
  name                String
  email               String              @unique
  passwordHash        String
  avatarUrl           String?
  activeBabyProfileId String?
  role                UserRole            @default(PARENT)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  conversations       Conversation[]
  babyProfiles        BabyProfile[]
  timelineEvents      TimelineEvent[]
  reminders           Reminder[]
  careLogs            CareLog[]
  growthRecords       GrowthRecord[]
  vaccinationRecords  VaccinationRecord[]
  medications         Medication[]
  doctorReports       DoctorReport[]
  shareLinks          ShareLink[]
  notifications       Notification[]
  auditLogs           AuditLog[]
}

model BabyProfile {
  id                  String              @id @default(cuid())
  userId              String
  babyName            String?
  avatarUrl           String?
  birthDate           DateTime?
  gender              String?
  weightKg            Float?
  heightCm            Float?
  headCircumferenceCm Float?
  feedingStyle        String?
  allergies           String?
  pediatricianName    String?
  pediatricianPhone   String?
  medicalNotes        String?
  emergencyPhone      String?
  preferredLanguage   String              @default("ar")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  timelineEvents      TimelineEvent[]
  reminders           Reminder[]
  careLogs            CareLog[]
  growthRecords       GrowthRecord[]
  vaccinationRecords  VaccinationRecord[]
  medications         Medication[]
  doctorReports       DoctorReport[]
  notifications       Notification[]
  conversations       Conversation[]
}

model TimelineEvent {
  id            String            @id @default(cuid())
  userId        String
  babyProfileId String?
  type          TimelineEventType
  title         String
  summary       String
  severity      SeverityLevel     @default(LOW)
  triage        TriageLevel?
  riskScore     Int?
  metadata      Json?
  createdAt     DateTime          @default(now())
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  babyProfile   BabyProfile?      @relation(fields: [babyProfileId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([babyProfileId, createdAt])
}

model Reminder {
  id                String          @id @default(cuid())
  userId            String
  babyProfileId     String?
  title             String
  message           String
  channel           ReminderChannel @default(APP)
  phoneNumber       String?
  scheduledFor      DateTime
  status            ReminderStatus  @default(SCHEDULED)
  provider          String?
  providerMessageId String?
  lastAttemptAt     DateTime?
  errorMessage      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  babyProfile       BabyProfile?    @relation(fields: [babyProfileId], references: [id], onDelete: SetNull)

  @@index([userId, scheduledFor])
  @@index([status, scheduledFor])
}

model CareLog {
  id            String       @id @default(cuid())
  userId        String
  babyProfileId String?
  type          CareLogType
  value         Float?
  unit          String?
  note          String?
  occurredAt    DateTime
  metadata      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  babyProfile   BabyProfile? @relation(fields: [babyProfileId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([babyProfileId, occurredAt])
  @@index([userId, type, occurredAt])
}

model GrowthRecord {
  id                  String       @id @default(cuid())
  userId              String
  babyProfileId       String?
  weightKg            Float?
  heightCm            Float?
  headCircumferenceCm Float?
  recordedAt          DateTime
  note                String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  babyProfile         BabyProfile? @relation(fields: [babyProfileId], references: [id], onDelete: SetNull)

  @@index([userId, recordedAt])
  @@index([babyProfileId, recordedAt])
}

model VaccinationRecord {
  id            String            @id @default(cuid())
  userId        String
  babyProfileId String?
  vaccineName   String
  dueDate       DateTime
  completedAt   DateTime?
  status        VaccinationStatus @default(DUE)
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  babyProfile   BabyProfile?      @relation(fields: [babyProfileId], references: [id], onDelete: SetNull)

  @@index([userId, dueDate])
  @@index([babyProfileId, dueDate])
  @@index([status, dueDate])
}

model Medication {
  id            String           @id @default(cuid())
  userId        String
  babyProfileId String?
  name          String
  dosage        String
  frequency     String
  instructions  String?
  startDate     DateTime
  endDate       DateTime?
  active        Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  babyProfile   BabyProfile?     @relation(fields: [babyProfileId], references: [id], onDelete: SetNull)
  doses         MedicationDose[]

  @@index([userId, active])
  @@index([babyProfileId, active])
}

model MedicationDose {
  id           String               @id @default(cuid())
  medicationId String
  scheduledFor DateTime
  takenAt      DateTime?
  skippedAt    DateTime?
  status       MedicationDoseStatus @default(SCHEDULED)
  note         String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  medication   Medication           @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@index([medicationId, scheduledFor])
  @@index([status, scheduledFor])
}

model DoctorReport {
  id            String         @id @default(cuid())
  userId        String
  babyProfileId String?
  title         String
  summary       String
  content       String
  riskScore     Int?
  triage        TriageLevel?
  severity      SeverityLevel?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  babyProfile   BabyProfile?   @relation(fields: [babyProfileId], references: [id], onDelete: SetNull)
  shareLinks    ShareLink[]

  @@index([userId, createdAt])
  @@index([babyProfileId, createdAt])
}

model ShareLink {
  id             String       @id @default(cuid())
  userId         String
  doctorReportId String
  token          String       @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  viewCount      Int          @default(0)
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorReport   DoctorReport @relation(fields: [doctorReportId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Notification {
  id            String              @id @default(cuid())
  userId        String
  babyProfileId String?
  title         String
  message       String
  channel       NotificationChannel @default(APP)
  status        NotificationStatus  @default(SCHEDULED)
  scheduledFor  DateTime?
  sentAt        DateTime?
  readAt        DateTime?
  errorMessage  String?
  metadata      Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  babyProfile   BabyProfile?        @relation(fields: [babyProfileId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, scheduledFor])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  ipAddress  String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model Conversation {
  id            String       @id @default(cuid())
  title         String
  userId        String
  babyProfileId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  babyProfile   BabyProfile? @relation(fields: [babyProfileId], references: [id], onDelete: SetNull)
  messages      Message[]

  @@index([userId, updatedAt])
  @@index([babyProfileId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           Role
  content        String
  audioFileName  String?
  predictedClass String?
  confidence     Float?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum UserRole {
  PARENT
  DOCTOR
  ADMIN
}

enum Role {
  USER
  ASSISTANT
}

enum TimelineEventType {
  PROFILE_UPDATED
  CRY_ANALYSIS
  TRIAGE_ASSESSMENT
  CHAT_GUIDANCE
  REMINDER_CREATED
  REMINDER_SENT
  NOTE
}

enum SeverityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TriageLevel {
  HOME_CARE
  WATCH_CLOSELY
  PEDIATRICIAN_SOON
  URGENT_NOW
}

enum ReminderStatus {
  DRAFT
  SCHEDULED
  SENT
  FAILED
}

enum ReminderChannel {
  APP
  WHATSAPP
  EMAIL
}

enum CareLogType {
  FEEDING
  SLEEP
  TEMPERATURE
  DIAPER
  CRYING
  MEDICATION
  VOMITING
  NOTE
}

enum VaccinationStatus {
  DUE
  COMPLETED
  SKIPPED
}

enum MedicationDoseStatus {
  SCHEDULED
  TAKEN
  SKIPPED
  MISSED
}

enum NotificationChannel {
  APP
  WHATSAPP
  EMAIL
}

enum NotificationStatus {
  DRAFT
  SCHEDULED
  SENT
  FAILED
  READ
}
